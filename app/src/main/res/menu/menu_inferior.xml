<?xml version="1.0" encoding="utf-8"?>
<!--
    Definición del menú para la barra de navegación inferior (Bottom Navigation).
    Contiene los ítems principales de la aplicación: Inicio, Historial, Estadísticas y Perfil.
    Cada ítem tiene un ID único que se utiliza en NavigationHelper para gestionar los clics.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/menu_inicio"
        android:icon="@android:drawable/ic_menu_today"
        android:title="Inicio"/>

    <item
        android:id="@+id/menu_historial"
        android:icon="@android:drawable/ic_menu_recent_history"
        android:title="Historial"/>

    <item
        android:id="@+id/menu_estadisticas"
        android:icon="@android:drawable/ic_menu_sort_by_size"
        android:title="Estadísticas"/>

    <item
        android:id="@+id/menu_perfil"
        android:icon="@android:drawable/ic_menu_myplaces"
        android:title="Perfil"/>

</menu>