<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout para la pantalla de Historial de Comidas.
    Utiliza un FrameLayout como raíz para superponer la navegación flotante.
    Contiene un RecyclerView para listar las comidas y un layout informativo (layoutVacio)
    que se muestra cuando no hay registros en la base de datos.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".activities.HistorialActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Encabezado con título y botón de retroceso -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/BtnVolverHistorial"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:contentDescription="Volver"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/secondary" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Historial de Comidas"
                android:textColor="@color/secondary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Contenido Principal: RecyclerView o Estado Vacío -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Lista de registros cronológicos -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistorial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="16dp"
                android:paddingBottom="100dp"
                android:visibility="gone" />

            <!-- Vista informativa para cuando no hay datos -->
            <LinearLayout
                android:id="@+id/layoutVacio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="@color/primary"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Sin registros" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu historial aparecerá aquí"
                    android:textColor="@color/secondary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Todavía no tienes registros guardados. ¡Empieza a registrar tus comidas!"
                    android:textColor="#475569"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Inclusión de la barra de navegación flotante -->
    <include layout="@layout/floating_bottom_nav" />

</FrameLayout>