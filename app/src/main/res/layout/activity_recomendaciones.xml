<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout para la pantalla de Recomendaciones Personalizadas.
    Presenta una tarjeta central (MaterialCardView) que muestra un consejo nutricional
    basado en el comportamiento de la última semana. Incluye un icono visual grande (emoji),
    un título destacado y un texto explicativo detallado.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".activities.RecomendacionesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Encabezado con título y navegación hacia atrás -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#1c7d55"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Mis Recomendaciones"
                android:textColor="#131f1a"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Contenido principal con scroll -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="100dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Resumen informativo sobre el cálculo del progreso -->
                <TextView
                    android:id="@+id/tvConsumoPromedio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calculando tu progreso..."
                    android:textColor="#64748b"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <!-- Card central: El sistema experto muestra aquí su consejo -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@android:color/white"
                    android:layout_marginBottom="32dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="32dp">

                        <!-- Icono visual representativo (Emoji grande) -->
                        <TextView
                            android:id="@+id/tvEmojiIcono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨"
                            android:textSize="80sp"
                            android:layout_marginBottom="16dp" />

                        <!-- Título de la recomendación -->
                        <TextView
                            android:id="@+id/tvTituloRecomendacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cargando..."
                            android:textColor="#1c7d55"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="12dp" />

                        <!-- Separador visual minimalista -->
                        <View
                            android:layout_width="60dp"
                            android:layout_height="4dp"
                            android:background="#1A1C7D55"
                            android:layout_marginBottom="20dp" />

                        <!-- Descripción detallada y personalizada -->
                        <TextView
                            android:id="@+id/tvTextoRecomendacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Estamos analizando tus registros de la última semana para darte el mejor consejo."
                            android:textColor="#475569"
                            android:textSize="16sp"
                            android:lineSpacingExtra="4dp"
                            android:gravity="center" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botón de confirmación/lectura -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolverInicio"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#1c7d55"
                    android:text="Entendido"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="16dp" />

                <!-- Nota informativa sobre la fuente de datos -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Las recomendaciones se basan en el promedio de tus últimos 7 días de registro."
                    android:textColor="#94a3b8"
                    android:textSize="12sp"
                    android:gravity="center" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Inclusión de la barra de navegación flotante -->
    <include layout="@layout/floating_bottom_nav" />

</FrameLayout>