<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout para la pantalla de Recuperación de Contraseña.
    Permite al usuario solicitar un enlace de restablecimiento ingresando su email.
    Sigue la línea visual de las pantallas de acceso, con botones Material Design
    y un ScrollView para evitar problemas de visualización con el teclado.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Encabezado con título y navegación hacia atrás -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <ImageView
                android:id="@+id/btnBackHeader"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@android:drawable/ic_media_previous"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/primary"
                android:contentDescription="Volver" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recuperar contraseña"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/primary"
                android:gravity="center"
                android:layout_marginEnd="48dp"/>
        </LinearLayout>

        <!-- Icono representativo de seguridad/candado -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            android:src="@android:drawable/ic_lock_power_off"
            app:tint="@color/primary"
            android:contentDescription="Icono de recuperación" />

        <!-- Título principal -->
        <TextView
            style="@style/TextAppearance.Kcal.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Olvidaste tu contraseña?"
            android:textSize="26sp"
            android:gravity="center"
            android:layout_marginTop="30dp"/>

        <!-- Instrucciones para el usuario -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Introduce tu correo electrónico para recibir un enlace de recuperación."
            android:gravity="center"
            android:textColor="#475569"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"/>

        <!-- Campo de entrada para el email -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:hint="Email"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="@color/primary"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/EmailRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón para ejecutar el envío del correo -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Enviar código / enlace"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            app:cornerRadius="12dp"/>

        <!-- Aviso legal/informativo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Si el correo coincide con una cuenta activa, recibirás instrucciones en unos minutos."
            android:textSize="14sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginTop="24dp"/>

        <!-- Opción secundaria para volver al login -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Volver al Login"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>