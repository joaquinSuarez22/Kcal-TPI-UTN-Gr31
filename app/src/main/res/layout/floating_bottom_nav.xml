<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de utilidad para la barra de navegación flotante personalizada.
    Este archivo se incluye (mediante <include>) en todas las actividades principales.
    Diseñado como una 'píldora' con elevación y bordes redondeados que flota
    en la parte inferior de la pantalla.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_nav_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:paddingBottom="24dp"
    android:paddingLeft="24dp"
    android:paddingRight="24dp">

    <!-- Contenedor principal de la navegación (estilo píldora) -->
    <LinearLayout
        android:id="@+id/nav_pill"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@drawable/nav_pill_background"
        android:gravity="center"
        android:elevation="8dp">

        <!-- Botón: Inicio -->
        <LinearLayout
            android:id="@+id/nav_inicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_inicio"
                android:src="@drawable/ic_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_inicio"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.05"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- Botón: Historial -->
        <LinearLayout
            android:id="@+id/nav_historial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_historial"
                android:src="@drawable/ic_history" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_historial"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.05"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- Botón: Estadísticas -->
        <LinearLayout
            android:id="@+id/nav_estadisticas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_estadisticas"
                android:src="@drawable/ic_stats" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_estadisticas"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.05"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- Botón: Perfil -->
        <LinearLayout
            android:id="@+id/nav_perfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_perfil"
                android:src="@drawable/ic_person" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_perfil"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.05"
                android:textAllCaps="true" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>