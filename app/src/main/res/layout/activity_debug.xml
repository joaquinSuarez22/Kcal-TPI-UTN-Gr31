<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel de Debug"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btnCargarComidasDebug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cargar 7 días de comidas (Fake Data)" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Esto llenará tu historial con datos aleatorios para probar las recomendaciones."
        android:textAlignment="center"
        android:textSize="14sp" />

</LinearLayout>