<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout para la pantalla de Estadísticas.
    Presenta un análisis visual de la ingesta calórica mediante un gráfico de barras dinámico
    y la distribución porcentual de macronutrientes.
    Permite filtrar los datos por Día, Semana o Mes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DEF4C6"
    tools:context=".activities.EstadisticasActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Encabezado con título y botones de acción (Atrás y Compartir) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#1c7d55"
                android:contentDescription="Volver" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Estadísticas"
                android:textColor="#131f1a"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_share"
                app:tint="#1c7d55"
                android:contentDescription="Compartir" />
        </RelativeLayout>

        <!-- Selector de periodo de tiempo (Filtros) -->
        <LinearLayout
            android:id="@+id/periodSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvPeriodoDia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DÍA"
                android:textStyle="bold"
                android:textColor="#64748b"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />

            <TextView
                android:id="@+id/tvPeriodoSemana"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEMANA"
                android:textStyle="bold"
                android:textColor="#1c7d55"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />

            <TextView
                android:id="@+id/tvPeriodoMes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MES"
                android:textStyle="bold"
                android:textColor="#64748b"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />
        </LinearLayout>

        <!-- Contenido principal con scroll -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="100dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Tarjeta principal: Ingesta calórica y Gráfico -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#ffffff">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INGESTA CALÓRICA TOTAL"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#64748b" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/tvCaloriasTotales"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:textColor="#0f172a" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" kcal"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1c7d55"
                                android:layout_gravity="bottom"
                                android:paddingBottom="6dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvComparativaPeriodo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cargando datos..."
                            android:textColor="#64748b"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <!-- Contenedores donde se dibujan las barras y etiquetas del gráfico -->
                        <LinearLayout
                            android:id="@+id/chartContainer"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:paddingTop="10dp"
                            android:background="#f8fafc" />

                        <LinearLayout
                            android:id="@+id/chartLabelsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Tarjetas de indicadores secundarios: Promedio y Días -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#ffffff">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_sort_by_size"
                                app:tint="#1c7d55"
                                android:layout_marginBottom="8dp"
                                android:contentDescription="Promedio" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PROMEDIO DIARIO"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#64748b"/>
                            <TextView
                                android:id="@+id/tvPromedioSemanal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 kcal"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#0f172a"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#ffffff">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_today"
                                app:tint="#1c7d55"
                                android:layout_marginBottom="8dp"
                                android:contentDescription="Días registrados" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DÍAS REGISTRADOS"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#64748b"/>
                            <TextView
                                android:id="@+id/tvDiasRegistrados"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 días"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#0f172a"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Desglose nutricional (Macronutrientes) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distribución de Macronutrientes"
                    android:textColor="#0f172a"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#ffffff"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Proteínas -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="PROTEÍNAS"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#3b82f6" />
                            <TextView
                                android:id="@+id/tvPorcentajeProteinas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#475569" />
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/pbProteinas"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:progressTint="#3b82f6"
                            android:progress="0"
                            android:max="100"
                            android:layout_marginBottom="12dp"/>

                        <!-- Carbohidratos -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="CARBOHIDRATOS"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#eab308" />
                            <TextView
                                android:id="@+id/tvPorcentajeCarbos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#475569" />
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/pbCarbos"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:progressTint="#eab308"
                            android:progress="0"
                            android:max="100"
                            android:layout_marginBottom="12dp"/>

                        <!-- Grasas -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="GRASAS"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#ef4444" />
                            <TextView
                                android:id="@+id/tvPorcentajeGrasas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#475569" />
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/pbGrasas"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:progressTint="#ef4444"
                            android:progress="0"
                            android:max="100"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Botón de acceso a recomendaciones -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecomendaciones"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#1c7d55"
                    android:text="Ver recomendaciones"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Personalizado basado en tus registros"
                    android:textColor="#94a3b8"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Barra de navegación flotante -->
    <include layout="@layout/floating_bottom_nav" />

</FrameLayout>