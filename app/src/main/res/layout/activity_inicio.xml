<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout para la pantalla principal (Dashboard).
    Utiliza una estructura de capas (FrameLayout) para posicionar la navegación flotante
    sobre el contenido principal que es desplazable (ScrollView).
    Se divide en secciones: Resumen Calórico central, Macronutrientes y Lista de Comidas.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- CONTENIDO PRINCIPAL DESPLAZABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- HEADER / LOGO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Kcal.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kcal"
                    android:textSize="28sp" />

            </LinearLayout>


            <!-- SECCIÓN 1: RESUMEN DE CALORÍAS
                 Muestra un indicador circular con las calorías restantes del día.
            -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:clipChildren="false">

                    <TextView
                        style="@style/TextAppearance.Kcal.SubHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Calorías"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Restantes = Objetivo - Alimentos"
                        android:textColor="#777"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginTop="20dp"
                        android:clipChildren="false">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progresoCaloriasCircular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            app:indicatorColor="@color/primary"
                            app:indicatorSize="160dp"
                            app:trackColor="#F1F5F9"
                            app:trackThickness="12dp"
                            android:progress="0"
                            android:max="100"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtCaloriasRestantesCentro"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@android:color/black"
                                android:textSize="32sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="restantes"
                                android:textColor="#777"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtObjetivoTotalCalorias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Objetivo: 0 kcal"
                        android:textColor="#777"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN 2: DISTRIBUCIÓN DE MACRONUTRIENTES
                 Desglose visual de Carbohidratos, Proteínas y Grasas en indicadores circulares pequeños.
            -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:clipChildren="false">

                    <TextView
                        style="@style/TextAppearance.Kcal.SubHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Macronutrientes"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:clipChildren="false">

                        <!-- Carbohidratos -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:clipChildren="false">

                            <FrameLayout
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:clipChildren="false">
                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/progresoCarbos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    app:indicatorColor="#FFA000"
                                    app:indicatorSize="70dp"
                                    app:trackColor="#F1F5F9"
                                    app:trackThickness="6dp"
                                    android:progress="0"/>
                                <TextView
                                    android:id="@+id/txtCarbosGramos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="0g"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Carbos"
                                android:textSize="12sp"
                                android:textColor="#777"/>
                        </LinearLayout>

                        <!-- Proteínas -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:clipChildren="false">

                            <FrameLayout
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:clipChildren="false">
                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/progresoProteinas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    app:indicatorColor="#F44336"
                                    app:indicatorSize="70dp"
                                    app:trackColor="#F1F5F9"
                                    app:trackThickness="6dp"
                                    android:progress="0"/>
                                <TextView
                                    android:id="@+id/txtProteinasGramos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="0g"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Proteínas"
                                android:textSize="12sp"
                                android:textColor="#777"/>
                        </LinearLayout>

                        <!-- Grasas -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:clipChildren="false">

                            <FrameLayout
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:clipChildren="false">
                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/progresoGrasas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    app:indicatorColor="#4CAF50"
                                    app:indicatorSize="70dp"
                                    app:trackColor="#F1F5F9"
                                    app:trackThickness="6dp"
                                    android:progress="0"/>
                                <TextView
                                    android:id="@+id/txtGrasasGramos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="0g"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Grasas"
                                android:textSize="12sp"
                                android:textColor="#777"/>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN 3: LISTADO DE COMIDAS POR CATEGORÍA
                 Utiliza el tag 'include' para reutilizar el layout item_comida_dashboard.xml
                 para cada una de las categorías de comida.
            -->
            <TextView
                style="@style/TextAppearance.Kcal.SubHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Comidas de hoy"
                android:textSize="18sp" />

            <!-- Cada include representa una tarjeta interactiva en el Dashboard -->
            <include layout="@layout/item_comida_dashboard"
                android:id="@+id/itemDesayuno" />

            <include layout="@layout/item_comida_dashboard"
                android:id="@+id/itemAlmuerzo" />

            <include layout="@layout/item_comida_dashboard"
                android:id="@+id/itemMerienda" />

            <include layout="@layout/item_comida_dashboard"
                android:id="@+id/itemCena" />

            <include layout="@layout/item_comida_dashboard"
                android:id="@+id/itemSnacks" />

            <!-- Botón de utilidad para desarrolladores -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDebug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="DEBUG: CARGAR COMIDAS"
                app:backgroundTint="#FF9800" />

        </LinearLayout>

    </ScrollView>

    <!-- BARRA DE NAVEGACIÓN FLOTANTE (PÍLDORA)
         Se posiciona sobre el ScrollView gracias al FrameLayout padre.
    -->
    <include layout="@layout/floating_bottom_nav" />

</FrameLayout>